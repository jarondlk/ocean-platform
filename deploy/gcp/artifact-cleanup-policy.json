[
  {
    "name": "delete-untagged-after-30-days",
    "action": {
      "type": "Delete"
    },
    "condition": {
      "tagState": "any",
      "olderThan": "30d"
    }
  },
  {
    "name": "keep-five-recent-versions",
    "action": {
      "type": "Keep"
    },
    "mostRecentVersions": {
      "keepCount": 5
    }
  }
]
