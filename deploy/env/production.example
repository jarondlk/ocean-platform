# OCEAN Platform production template
#
# Copy this file to a secret-managed location outside the repository. Replace
# every angle-bracketed value before validating deploy/compose/production.yml.

NEXT_PORT=3000

POSTGRES_USER=ocean_app
POSTGRES_PASSWORD=<generate-a-random-database-password>
POSTGRES_DB=ocean_platform
DATABASE_URL=postgresql://ocean_app:<url-encoded-database-password>@postgres:5432/ocean_platform
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_BACKUP_CONTAINER=
DATABASE_BACKUP_DIR=/app/data/backups

DATA_DIR=/app/data
JOB_EXECUTION_MODE=external
LOCAL_MAX_ACTIVE_JOBS=1

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://<private-ollama-host>:11434
CHAT_MODEL=qwen2.5:14b-instruct
EMBEDDING_MODEL=nomic-embed-text

DEPLOYMENT_ENV=production
AUTH_MODE=required
AUTH_ALLOWED_PROVIDERS=oidc
PERSIST_LOCAL_CHAT=false
ENABLE_MOCK_LOGIN=false

AUTH_URL=https://rag.example.org
AUTH_TRUST_HOST=false
AUTH_SECRET=<generate-an-independent-random-value-of-at-least-32-characters>
INTERNAL_AUTH_SECRET=<generate-a-different-random-value-of-at-least-32-characters>
INTERNAL_AUTH_ISSUER=ocean-platform-frontend
INTERNAL_AUTH_AUDIENCE=ocean-platform-api

OIDC_PROVIDER_NAME=Managed identity provider
OIDC_PROVIDER_ID=oidc
OIDC_ISSUER=https://identity.example.org
OIDC_CLIENT_ID=<provider-client-id>
OIDC_CLIENT_SECRET=<provider-client-secret>

CORS_ORIGINS=https://rag.example.org
