{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "available",
            "unknown",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "CatalogueCount": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "complete_scope",
          "default": "complete_scope",
          "title": "Basis",
          "type": "string"
        },
        "denominator": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Denominator",
          "type": "string"
        },
        "entity": {
          "enum": [
            "canonical_objects",
            "datasets",
            "observations",
            "source_occurrences",
            "assays",
            "detection_rows",
            "rows"
          ],
          "title": "Entity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "state",
        "entity",
        "denominator"
      ],
      "title": "CatalogueCount",
      "type": "object"
    },
    "EDNADataset": {
      "additionalProperties": false,
      "properties": {
        "collection_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Collection Id",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "descriptor": {
          "$ref": "#/$defs/EDNADescriptor"
        },
        "family": {
          "const": "edna_metabarcoding",
          "default": "edna_metabarcoding",
          "title": "Family",
          "type": "string"
        },
        "methods": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "provider": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider",
          "type": "string"
        },
        "provider_locus": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Locus"
        },
        "provider_project_id": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Provider Project Id",
          "type": "string"
        },
        "provider_team": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Team"
        },
        "purpose": {
          "$ref": "#/$defs/LocalizedText"
        },
        "qualification": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Qualification",
          "type": "string"
        },
        "related_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Related Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "catalogue-edna-dataset-v1",
          "default": "catalogue-edna-dataset-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "tables": {
          "items": {
            "$ref": "#/$defs/EDNATable"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Tables",
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        }
      },
      "required": [
        "dataset_id",
        "source_id",
        "provider",
        "provider_locus",
        "provider_team",
        "provider_project_id",
        "collection_id",
        "title",
        "purpose",
        "descriptor",
        "qualification",
        "methods",
        "tables"
      ],
      "title": "EDNADataset",
      "type": "object"
    },
    "EDNADescriptor": {
      "additionalProperties": false,
      "properties": {
        "assignment_method": {
          "enum": [
            "qcauto_target",
            "qcauto_95pct_3nn_target",
            "qcauto_nontarget",
            "qcauto_95pct_3nn_nontarget",
            "mixed",
            "unknown"
          ],
          "title": "Assignment Method",
          "type": "string"
        },
        "family": {
          "const": "edna_metabarcoding",
          "title": "Family",
          "type": "string"
        },
        "is_control": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Is Control"
        },
        "measurement": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Measurement",
          "type": "string"
        },
        "population": {
          "default": "scientific",
          "enum": [
            "scientific",
            "raw_inventory"
          ],
          "title": "Population",
          "type": "string"
        },
        "protocol": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Protocol",
          "type": "string"
        },
        "protocol_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Protocol Id",
          "type": "string"
        },
        "sample_kind": {
          "enum": [
            "environmental",
            "negative_control",
            "positive_control",
            "mock_community",
            "unknown",
            "mixed"
          ],
          "title": "Sample Kind",
          "type": "string"
        },
        "unit": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "family",
        "protocol_id",
        "protocol",
        "assignment_method",
        "sample_kind",
        "is_control",
        "measurement",
        "unit"
      ],
      "title": "EDNADescriptor",
      "type": "object"
    },
    "EDNAResponse": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "c12-v1",
          "default": "c12-v1",
          "title": "Adapter Version",
          "type": "string"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Offset"
        },
        "offset": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "qualifications": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Qualifications",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/QueryResult"
        }
      },
      "required": [
        "result",
        "qualifications"
      ],
      "title": "EDNAResponse",
      "type": "object"
    },
    "EDNATable": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown",
            "unavailable"
          ],
          "title": "Completeness",
          "type": "string"
