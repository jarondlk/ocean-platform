        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/EdnaFilters"
        }
      },
      "required": [
        "enabled",
        "filters"
      ],
      "title": "EdnaSelection",
      "type": "object"
    },
    "EvidenceScope": {
