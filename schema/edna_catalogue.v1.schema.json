        "name": {
          "enum": [
            "occurrences",
            "assays",
            "detections",
            "classifications"
          ],
          "title": "Name",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Object Id"
        },
        "row_count": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Row Count"
        }
      },
      "required": [
        "name",
        "object_id",
        "row_count",
        "availability",
        "completeness"
      ],
      "title": "EDNATable",
      "type": "object"
    },
