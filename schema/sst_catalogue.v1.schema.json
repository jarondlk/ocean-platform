{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "available",
            "unknown",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "CatalogueCount": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "complete_scope",
          "default": "complete_scope",
          "title": "Basis",
          "type": "string"
        },
        "denominator": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Denominator",
          "type": "string"
        },
        "entity": {
          "enum": [
            "canonical_objects",
            "datasets",
            "observations",
            "source_occurrences",
            "assays",
            "detection_rows",
            "rows"
          ],
          "title": "Entity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "state",
        "entity",
        "denominator"
      ],
      "title": "CatalogueCount",
      "type": "object"
    },
    "EdnaFilters": {
      "additionalProperties": false,
      "properties": {
        "assignment_method": {
          "anyOf": [
            {
              "enum": [
                "qcauto_target",
                "qcauto_95pct_3nn_target"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignment Method"
        },
        "is_control": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Control"
        },
        "lat_max": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat Max"
        },
        "lat_min": {
          "anyOf": [
            {
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat Min"
        },
        "lon_max": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon Max"
        },
        "lon_min": {
          "anyOf": [
            {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon Min"
        },
        "provider": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "provider_project_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Project Id"
        },
        "provider_run_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Run Id"
        },
        "sample_id": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Id"
        },
        "sample_kind": {
          "anyOf": [
            {
              "enum": [
                "environmental",
                "negative_control",
                "positive_control",
                "mock_community",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Kind"
        },
        "taxon": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxon"
        },
        "time_from": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time From"
        },
        "time_to": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time To"
        }
      },
      "title": "EdnaFilters",
      "type": "object"
    },
    "EdnaSelection": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Id"
        },
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "filters": {
          "$ref": "#/$defs/EdnaFilters"
        }
      },
      "required": [
        "enabled",
        "filters"
      ],
      "title": "EdnaSelection",
      "type": "object"
    },
    "EvidenceScope": {
      "additionalProperties": false,
      "properties": {
        "sources": {
          "$ref": "#/$defs/SourceSelections"
        },
        "version": {
          "const": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "version",
        "sources"
      ],
      "title": "EvidenceScope",
      "type": "object"
    },
    "InputIdentity": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "object_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "source_generation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Generation"
        }
      },
      "required": [
        "object_id",
        "content_sha256"
      ],
      "title": "InputIdentity",
      "type": "object"
    },
    "JsonValue": {},
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "en": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "En",
          "type": "string"
        },
        "ja": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Ja",
          "type": "string"
        }
      },
      "required": [
        "en",
        "ja"
      ],
      "title": "LocalizedText",
      "type": "object"
    },
    "OperationReceipt": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "enum": [
            "descriptive",
            "published",
            "experimental"
          ],
          "title": "Authority",
          "type": "string"
        },
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "content_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputIdentity"
          },
          "title": "Inputs",
          "type": "array"
        },
        "operation_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation Id",
          "type": "string"
        },
        "operation_version": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Operation Version",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Parameters",
          "type": "object"
        },
        "preview_truncated": {
          "title": "Preview Truncated",
          "type": "boolean"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "query_completion": {
          "enum": [
            "not_started",
            "complete",
            "partial",
            "failed"
          ],
          "title": "Query Completion",
          "type": "string"
        },
        "receipt_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Receipt Id",
          "type": "string"
        },
        "returned_count": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Returned Count",
          "type": "integer"
        },
        "schema_version": {
          "const": "context-catalogue-v1",
          "default": "context-catalogue-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EvidenceScope"
        },
        "scope_compatibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScopeCompatibility"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Snapshot Id",
          "type": "string"
        },
        "source_completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown",
            "unavailable"
          ],
          "title": "Source Completeness",
          "type": "string"
        },
        "total_rows": {
          "$ref": "#/$defs/CatalogueCount"
        }
      },
      "required": [
        "snapshot_id",
        "scope",
        "receipt_id",
        "operation_id",
        "operation_version",
        "inputs",
        "authority",
        "availability",
        "provenance",
        "total_rows",
        "returned_count",
        "preview_truncated",
        "source_completeness",
        "query_completion",
        "content_sha256"
      ],
      "title": "OperationReceipt",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "content_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Sha256"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/$defs/TransferOrigin"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "references": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "References",
          "type": "array"
        },
        "source_generation": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Generation"
        }
      },
      "title": "Provenance",
      "type": "object"
    },
    "QueryResult": {
      "additionalProperties": false,
      "properties": {
        "columns": {
          "items": {
            "$ref": "#/$defs/ResultColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "receipt": {
          "$ref": "#/$defs/OperationReceipt"
        },
        "rows": {
          "items": {
            "additionalProperties": {
              "$ref": "#/$defs/JsonValue"
            },
            "type": "object"
          },
          "title": "Rows",
          "type": "array"
        },
        "schema_version": {
          "const": "context-catalogue-v1",
          "default": "context-catalogue-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/EvidenceScope"
        },
        "snapshot_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Snapshot Id",
          "type": "string"
        }
      },
      "required": [
        "snapshot_id",
        "scope",
        "columns",
        "rows",
        "receipt"
      ],
      "title": "QueryResult",
      "type": "object"
    },
    "ResultColumn": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Key",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "key",
        "title"
      ],
      "title": "ResultColumn",
      "type": "object"
    },
    "SSTDataset": {
      "additionalProperties": false,
      "properties": {
        "aggregation_method": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Aggregation Method",
          "type": "string"
        },
        "calendar": {
          "enum": [
            "UTC",
            "Asia/Tokyo"
          ],
          "title": "Calendar",
          "type": "string"
        },
        "collection_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Collection Id",
          "type": "string"
        },
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "descriptor": {
          "$ref": "#/$defs/SSTDescriptor"
        },
        "family": {
          "const": "remote_sensing",
          "default": "remote_sensing",
          "title": "Family",
          "type": "string"
        },
        "measurement_type": {
          "enum": [
            "satellite_retrieval",
            "satellite_in_situ_analysis",
            "model_assimilation"
          ],
          "title": "Measurement Type",
          "type": "string"
        },
        "methods": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Methods",
          "type": "array"
        },
        "observation_entity": {
          "enum": [
            "regional_daily_summary",
            "grid_observation"
          ],
          "title": "Observation Entity",
          "type": "string"
        },
        "observation_precision": {
          "enum": [
            "day",
            "datetime"
          ],
          "title": "Observation Precision",
          "type": "string"
        },
        "processing_generation": {
          "enum": [
            "final",
            "interim",
            "unknown"
          ],
          "title": "Processing Generation",
          "type": "string"
        },
        "product_node_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Product Node Id",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/LocalizedText"
        },
        "qualification": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Qualification",
          "type": "string"
        },
        "quality_policy": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Quality Policy",
          "type": "string"
        },
        "related_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Related Ids",
          "type": "array"
        },
        "sampling": {
          "anyOf": [
            {
              "$ref": "#/$defs/SSTSampling"
            },
            {
              "type": "null"
            }
          ]
        },
        "schema_version": {
          "const": "catalogue-sst-dataset-v1",
          "default": "catalogue-sst-dataset-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Id",
          "type": "string"
        },
        "spatial_resolution_basis": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Spatial Resolution Basis",
          "type": "string"
        },
        "support": {
          "$ref": "#/$defs/SSTSupport"
        },
        "table": {
          "$ref": "#/$defs/SSTTable"
        },
        "temporal_statistic": {
          "enum": [
            "daily_foundation_analysis",
            "daily_mean",
            "instant_retrieval",
            "model_instant"
          ],
          "title": "Temporal Statistic",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "uncertainty_policy": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Uncertainty Policy",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "source_id",
        "product_node_id",
        "collection_id",
        "title",
        "purpose",
        "descriptor",
        "processing_generation",
        "measurement_type",
        "temporal_statistic",
        "calendar",
        "observation_precision",
        "support",
        "observation_entity",
        "sampling",
        "spatial_resolution_basis",
        "aggregation_method",
        "quality_policy",
        "uncertainty_policy",
        "qualification",
        "methods",
        "table"
      ],
      "title": "SSTDataset",
      "type": "object"
    },
    "SSTDescriptor": {
      "additionalProperties": false,
      "properties": {
        "family": {
          "const": "remote_sensing",
          "title": "Family",
          "type": "string"
        },
        "measurement": {
          "const": "sea_surface_temperature",
          "title": "Measurement",
          "type": "string"
        },
        "product_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "product_version": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Product Version",
          "type": "string"
        },
        "spatial_resolution": {
          "exclusiveMinimum": 0,
          "title": "Spatial Resolution",
          "type": "number"
        },
        "spatial_resolution_unit": {
          "enum": [
            "degree",
            "km",
            "m"
          ],
          "title": "Spatial Resolution Unit",
          "type": "string"
        },
        "spatial_role": {
          "enum": [
            "native_grid",
            "coarse_context",
            "regional_summary"
          ],
          "title": "Spatial Role",
          "type": "string"
        },
        "temporal_resolution": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Temporal Resolution",
          "type": "string"
        },
        "unit": {
          "enum": [
            "degC",
            "K"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "family",
        "product_id",
        "product_version",
        "spatial_resolution",
        "spatial_resolution_unit",
        "temporal_resolution",
        "measurement",
        "unit",
        "spatial_role"
      ],
      "title": "SSTDescriptor",
      "type": "object"
    },
    "SSTResponse": {
      "additionalProperties": false,
      "properties": {
        "adapter_version": {
          "const": "c11-v1",
          "default": "c11-v1",
          "title": "Adapter Version",
          "type": "string"
        },
        "next_offset": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Offset"
        },
        "offset": {
          "default": 0,
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "qualifications": {
          "items": {
            "maxLength": 4000,
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Qualifications",
          "type": "array"
        },
        "result": {
          "$ref": "#/$defs/QueryResult"
        }
      },
