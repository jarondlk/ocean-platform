{
  "$defs": {
    "Availability": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "status": {
          "enum": [
            "available",
            "unknown",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "title": "Availability",
      "type": "object"
    },
    "CatalogueCount": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "const": "complete_scope",
          "default": "complete_scope",
          "title": "Basis",
          "type": "string"
        },
        "denominator": {
          "maxLength": 4000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Denominator",
          "type": "string"
        },
        "entity": {
          "enum": [
            "canonical_objects",
            "datasets",
            "observations",
            "source_occurrences",
            "assays",
            "detection_rows",
            "rows"
          ],
          "title": "Entity",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "known",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "state",
        "entity",
        "denominator"
      ],
      "title": "CatalogueCount",
      "type": "object"
    },
    "DatasetBinding": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Dataset Id",
          "type": "string"
        },
        "snapshot_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Snapshot Id",
          "type": "string"
