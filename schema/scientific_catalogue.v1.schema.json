          "minItems": 1,
          "title": "Input Dataset Ids",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        },
        "purpose": {
          "$ref": "#/$defs/LocalizedText"
        },
        "title": {
          "$ref": "#/$defs/LocalizedText"
        },
        "values": {
          "additionalProperties": true,
          "title": "Values",
          "type": "object"
        }
