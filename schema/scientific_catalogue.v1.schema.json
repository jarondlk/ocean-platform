    "DatasetEndpoint": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
