          "title": "Source Family",
          "type": "string"
        },
        "source_id": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Id",
          "type": "string"
