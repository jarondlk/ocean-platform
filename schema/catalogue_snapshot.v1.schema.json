        "size_bytes": {
          "maximum": 536870912,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_family": {
          "enum": [
            "ctd",
            "metagenome",
            "remote_sensing",
            "edna_metabarcoding"
