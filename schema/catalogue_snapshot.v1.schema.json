  "$id": "urn:ocean:catalogue-snapshot:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "snapshot": {
      "$ref": "#/$defs/SnapshotManifest"
    },
    "transfer": {
      "$ref": "#/$defs/TransferManifest"
    }
  },
  "required": [
    "snapshot",
    "transfer"
  ],
  "title": "SnapshotContract",
  "type": "object",
  "x-runtime-validation-required": "Cross-object source/operation/origin bindings, exact bytes/counts, canonical IDs, strict scope semantics, and current access need Python validation."
}
