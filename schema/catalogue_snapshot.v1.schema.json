    "SnapshotManifest": {
      "additionalProperties": false,
      "properties": {
        "objects": {
          "items": {
            "$ref": "#/$defs/SnapshotObject"
          },
          "maxItems": 4000,
          "minItems": 1,
          "title": "Objects",
          "type": "array"
        },
        "operation_versions": {
          "minProperties": 1,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9._:-]*$": {
              "maxLength": 4000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            }
          },
          "propertyNames": {
            "maxLength": 256,
            "minLength": 1
          },
          "title": "Operation Versions",
          "type": "object"
        },
        "schema_version": {
          "const": "catalogue-snapshot-v1",
          "default": "catalogue-snapshot-v1",
          "title": "Schema Version",
          "type": "string"
