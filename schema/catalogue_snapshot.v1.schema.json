          "default": null,
          "title": "Time From"
        },
        "time_to": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time To"
        }
      },
      "title": "EdnaFilters",
      "type": "object"
    },
    "EdnaSelection": {
      "additionalProperties": false,
      "properties": {
        "analysis_id": {
