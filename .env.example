# Onagawa Source Chat local container settings

# Host port for the Streamlit UI.
STREAMLIT_PORT=8501

# Host ports for the Next.js migration stack.
NEXT_PORT=3000
API_PORT=8000

# Inside docker-compose.app.yml, the default DATABASE_URL points at the
# postgres service on the compose network. For running the app directly on
# your host, use:
# DATABASE_URL=postgresql://onagawa:onagawa@localhost:5433/onagawa_rag
DATABASE_URL=postgresql://onagawa:onagawa@postgres:5432/onagawa_rag

# For app+database containers, keep this pointed at Ollama on the host.
# For app+database+Ollama containers, docker-compose.ollama.yml overrides this
# to http://ollama:11434 automatically.
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_PORT=11434

CHAT_MODEL=qwen2.5:14b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Used by the Next.js frontend container to reach the FastAPI service.
API_BASE_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
