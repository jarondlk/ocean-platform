# Onagawa Source Chat local container settings

# Host ports for the Next.js + FastAPI stack.
NEXT_PORT=3000
API_PORT=8000

# Inside docker-compose.next.yml, the default DATABASE_URL points at the
# postgres service on the compose network. For running the API directly on your
# host, use:
# DATABASE_URL=postgresql://onagawa:onagawa@localhost:5433/onagawa_rag
DATABASE_URL=postgresql://onagawa:onagawa@postgres:5432/onagawa_rag

# For API+frontend+database containers, keep this pointed at Ollama on the host.
# For API+frontend+database+Ollama containers, set OLLAMA_BASE_URL to
# http://ollama:11434 when using docker-compose.ollama.yml.
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_PORT=11434

CHAT_MODEL=qwen2.5:14b-instruct
EMBEDDING_MODEL=nomic-embed-text

# Used by the Next.js frontend container to reach the FastAPI service.
API_BASE_URL=http://api:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Invite-only OIDC authentication. Generate AUTH_SECRET and
# INTERNAL_AUTH_SECRET independently; use at least 32 random bytes for each.
AUTH_MODE=required
# Local preview only: when AUTH_MODE=disabled, persist chats and feedback under
# the synthetic development administrator. Never enable this in production.
PERSIST_LOCAL_CHAT=false
AUTH_SECRET=replace-with-a-long-random-authjs-secret
INTERNAL_AUTH_SECRET=replace-with-a-different-long-random-internal-secret
INTERNAL_AUTH_ISSUER=onagawa-source-chat-frontend
INTERNAL_AUTH_AUDIENCE=onagawa-source-chat-api
AUTH_TRUST_HOST=true

# Generic OpenID Connect provider registration.
OIDC_PROVIDER_NAME=Organization account
OIDC_ISSUER=https://identity.example.org
OIDC_CLIENT_ID=replace-with-oidc-client-id
OIDC_CLIENT_SECRET=replace-with-oidc-client-secret
