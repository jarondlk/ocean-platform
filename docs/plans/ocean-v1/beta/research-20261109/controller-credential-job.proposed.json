{
  "apiVersion": "run.googleapis.com/v1",
  "kind": "Job",
  "metadata": {
    "name": "ocean-v1-beta-controller-credential",
    "namespace": "534831104543"
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "run.googleapis.com/container-dependencies": "{\"operator\":[\"sql-proxy\"]}",
          "run.googleapis.com/execution-environment": "gen2",
          "run.googleapis.com/network-interfaces": "[{\"network\":\"projects/ocean-v1-beta-20261101/global/networks/ocean-v1-beta-network\",\"subnetwork\":\"projects/ocean-v1-beta-20261101/regions/asia-northeast1/subnetworks/ocean-v1-beta-subnet\"}]",
          "run.googleapis.com/vpc-access-egress": "private-ranges-only"
        }
      },
      "spec": {
        "parallelism": 1,
        "taskCount": 1,
        "template": {
          "spec": {
            "containers": [
              {
                "args": [
                  "--confirm-project",
                  "ocean-v1-beta-20261101",
                  "--confirm-source",
                  "84fe01714e426a66ee7b30559b69ebe05ef8f04f"
                ],
                "env": [
                  {
                    "name": "DEPLOYMENT_ENV",
                    "value": "production"
                  },
                  {
                    "name": "OCEAN_V1_PROJECT_ID",
                    "value": "ocean-v1-beta-20261101"
                  },
                  {
                    "name": "OCEAN_V1_SQL_CONNECTION_NAME",
                    "value": "ocean-v1-beta-20261101:asia-northeast1:ocean-v1-beta-sql"
                  },
                  {
                    "name": "ENABLE_V1_RESEARCH_CONTROLLER",
                    "value": "false"
                  },
                  {
                    "name": "ENABLE_V1_RESEARCH_DISPATCH",
                    "value": "false"
                  },
                  {
                    "name": "ENABLE_V1_SYNTHESIS",
                    "value": "false"
                  },
                  {
                    "name": "ENABLE_V1_EXPERIMENT_DISPATCH",
                    "value": "false"
                  },
                  {
                    "name": "OCEAN_V1_CONTROLLER_CREDENTIAL_REVISION",
                    "value": "84fe01714e426a66ee7b30559b69ebe05ef8f04f"
                  },
                  {
                    "name": "OCEAN_V1_BOOTSTRAP_DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "key": "1",
                        "name": "ocean-v1-beta-bootstrap-database"
                      }
                    }
                  }
                ],
                "image": "asia-northeast1-docker.pkg.dev/ocean-v1-beta-20261101/ocean-v1-beta/controller-credential@sha256:e6d67cc2857e9b171a2cae7d77fe0bdc027783d967b21189a1551ef1607af27f",
                "name": "operator",
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "1Gi"
                  }
                }
              },
              {
                "args": [
                  "--private-ip",
                  "--address=127.0.0.1",
                  "--port=5432",
                  "--quitquitquit",
                  "--admin-port=9091",
                  "--health-check",
                  "--http-address=0.0.0.0",
                  "--http-port=9090",
                  "ocean-v1-beta-20261101:asia-northeast1:ocean-v1-beta-sql"
                ],
                "image": "gcr.io/cloud-sql-connectors/cloud-sql-proxy@sha256:f333a9c59890c3c67b8505166c5dbdcc0b29fca9173a2e09ca0446ab6997a736",
                "name": "sql-proxy",
                "resources": {
                  "limits": {
                    "cpu": "1",
                    "memory": "256Mi"
                  }
                },
                "startupProbe": {
                  "failureThreshold": 24,
                  "httpGet": {
                    "path": "/readiness",
                    "port": 9090
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                }
              }
            ],
            "maxRetries": 0,
            "serviceAccountName": "ocean-v1-beta-db-bootstrap@ocean-v1-beta-20261101.iam.gserviceaccount.com",
            "timeoutSeconds": "600"
          }
        }
      }
    }
  }
}
