{
  "containers": [
    {
      "env": [
        {
          "name": "DEPLOYMENT_ENV",
          "value": "production"
        },
        {
          "name": "AUTH_MODE",
          "value": "required"
        },
        {
          "name": "ENABLE_MOCK_LOGIN",
          "value": "false"
        },
        {
          "name": "PERSIST_LOCAL_CHAT",
          "value": "false"
        },
        {
          "name": "AUTH_URL",
          "value": "https://beta.oceaninfobio.com"
        },
        {
          "name": "V1_PUBLIC_ORIGIN",
          "value": "https://beta.oceaninfobio.com"
        },
        {
          "name": "V1_API_ORIGIN",
          "value": "http://127.0.0.1:8000"
        },
        {
          "name": "V1_INTERNAL_AUTH_ISSUER",
          "value": "ocean-v1-frontend"
        },
        {
          "name": "V1_INTERNAL_AUTH_AUDIENCE",
          "value": "ocean-v1-api"
        },
        {
          "name": "V1_GOOGLE_CLIENT_ID",
          "value": "534831104543-4l3hm9dqd60u320mf73ql0d3s9rsuprn.apps.googleusercontent.com"
        },
        {
          "name": "ENABLE_V1_CATALOGUE",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_CATALOGUE_BROWSER",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_SHELL",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_INVESTIGATIONS",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_RESEARCH_CONTROLLER",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_RESEARCH_RUNS",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_RESEARCH_DISPATCH",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_EVIDENCE",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_SYNTHESIS",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_EXPERIMENTS",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_EXPERIMENT_DISPATCH",
          "value": "false"
        },
        {
          "name": "ENABLE_V1_EXPERIMENT_WORKSPACE",
          "value": "false"
        }
      ],
      "image": "asia-northeast1-docker.pkg.dev/ocean-v1-beta-20261101/ocean-v1-beta/frontend@sha256:adb5bc75dbc56d146bdf6e63f83a3dc8b3867b0318de0c2c02ba6fc56023e9dc",
      "name": "frontend",
      "ports": [
        {
          "containerPort": 8080,
          "name": "http1"
        }
      ],
      "resources": {
        "cpuIdle": true,
        "limits": {
          "cpu": "1",
          "memory": "512Mi"
        },
        "startupCpuBoost": false
      },
      "startupProbe": {
        "tcpSocket": {
          "port": 8080
        },
        "timeoutSeconds": 2,
        "periodSeconds": 2,
        "failureThreshold": 20
      },
      "command": [
        "node"
      ],
      "args": [
        "-e",
        "const http=require('http');const expected={'host':'beta.oceaninfobio.com','x-forwarded-host':'beta.oceaninfobio.com','x-forwarded-proto':'https','x-forwarded-port':'443'};http.createServer((req,res)=>{if(req.url!=='/__ocean_transport_probe'){res.writeHead(503,{'Content-Type':'text/plain'});return res.end('Beta deployment in progress');}const h=req.headers;let out={forwarded_present:Object.hasOwn(h,'forwarded')};for(const [k,v] of Object.entries(expected)){out[k]=h[k]===undefined?'absent':h[k]===v?'expected':k==='x-forwarded-proto'&&h[k]==='http'?'http':k==='x-forwarded-port'&&h[k]==='8080'?'8080':Array.isArray(h[k])||String(h[k]).includes(',')?'multiple':'other';}res.writeHead(200,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(out));}).listen(8080,'0.0.0.0');"
      ]
    }
  ],
  "executionEnvironment": "EXECUTION_ENVIRONMENT_GEN2",
  "maxInstanceRequestConcurrency": 4,
  "scaling": {
    "maxInstanceCount": 1,
    "minInstanceCount": 0
  },
  "serviceAccount": "ocean-v1-beta-serving@ocean-v1-beta-20261101.iam.gserviceaccount.com",
  "timeout": "60s"
}
