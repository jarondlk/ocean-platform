{
  "name": "ocean-v1-authenticated-host",
  "version": "1.0.0-host.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3200",
    "start": "NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 node .next/standalone/hosting/server.js",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build && node scripts/package-standalone.mjs",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.ts",
    "test:server": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests-server/*.test.ts"
  },
  "dependencies": {
    "jose": "6.2.12",
    "lucide-react": "0.577.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2"
  }
}
